[Unit]
Description=GameCon queue worker
After=network.target redis-server.service mariadb.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/gamecon
ExecStart=/usr/bin/php artisan queue:work --sleep=1 --tries=3 --max-time=3600 --memory=256
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
