# Запасний перекладач GameCon (коли вичерпано ліміт DeepL). Ставить deploy/libretranslate.sh
# (INSTALL_LIBRETRANSLATE=1). Слухає лише 127.0.0.1 — ззовні недоступний, ключ не потрібен.
# Мови — у /opt/libretranslate/languages.env (LT_LOAD_ONLY), їх пише deploy/libretranslate.sh.
[Unit]
Description=LibreTranslate (GameCon fallback translator)
After=network.target

[Service]
User=libretranslate
Group=libretranslate
WorkingDirectory=/opt/libretranslate
Environment=HOME=/opt/libretranslate
Environment=ARGOS_DEVICE_TYPE=cpu
Environment=LT_LOAD_ONLY=uk,en,pl,de
EnvironmentFile=-/opt/libretranslate/languages.env
ExecStart=/opt/libretranslate/venv/bin/libretranslate --host 127.0.0.1 --port 5000 --threads 2 --disable-web-ui
Restart=always
RestartSec=10
# Моделі важкі: не даємо службі «з'їсти» всю пам'ять сервера.
MemoryMax=6G

[Install]
WantedBy=multi-user.target
