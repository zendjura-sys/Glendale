APP_NAME="Monsory Connect"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=uk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=uk_UA

# Другий публічний вхід для союзників родини (той самий застосунок/база/
# адмінка) — заповнити реальним доменом, напр. union.monsory.net. Порожньо
# за замовчуванням: без нього другий домен просто вимкнено.
UNION_DOMAIN=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=monsory_connect_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Явно зафіксовано (а не лишено на обчислення фреймворком за APP_NAME):
# Laravel 13 змінив цю логіку, і без явного значення перший же деплой на
# новій версії міг би підмінити і префікс кешу, і кукі сесії нижче — а
# останнє миттєво розлогінило б усіх, хто був залогінений.
CACHE_PREFIX=monsory-connect-cache-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Ссылка на Telegram-бота вайтлиста. Основной источник — настройки в
# админке; здесь оставлен запасной вариант на случай пустой базы.
TELEGRAM_BOT_URL=

# База Telegram Bot API. Менять только если api.telegram.org недоступен и
# нужен прокси — обычной установке это поле не нужно.
TELEGRAM_API_URL=https://api.telegram.org

# Токен Discord-бота для будущего проекта (php artisan discord:bot). Пусто
# по умолчанию — без токена команда сама откажется стартовать.
DISCORD_BOT_TOKEN=

# VAPID-ключи push-уведомлений — генерируются автоматически deploy/setup-vps.sh
# при первом деплое (php artisan tinker не нужен). Пусто по умолчанию — без
# ключей push-канал просто молчит, остальной сайт работает как обычно.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Токен лише для читання релізів приватного zendjura-sys/Glendale (APK застосунку)
GITHUB_RELEASES_TOKEN=
