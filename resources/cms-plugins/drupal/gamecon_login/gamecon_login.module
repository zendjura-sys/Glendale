<?php

/**
 * @file
 * Кнопка «Увійти через GameCon» у формі входу.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Link;
use Drupal\Core\Url;

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
function gamecon_login_form_user_login_form_alter(array &$form, FormStateInterface $form_state) {
  $config = \Drupal::config('gamecon_login.settings');
  if (!$config->get('client_id')) {
    return;
  }
  $form['gamecon'] = [
    '#type' => 'container',
    '#weight' => 100,
    'link' => Link::fromTextAndUrl(t('Увійти через GameCon'), Url::fromRoute('gamecon_login.login', [], [
      'attributes' => ['class' => ['button', 'button--primary', 'gamecon-login'], 'style' => 'background:#4f46e5;border-color:#4f46e5'],
    ]))->toRenderable(),
  ];
}
