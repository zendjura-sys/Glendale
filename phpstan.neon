includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Типи з PHPDoc (властивості й зв'язки моделей) не гарантують даних у БД: зв'язок може
    # вказувати на видалений запис, тому захисні ?-> і перевірки на null лишаємо, а не вважаємо зайвими.
    treatPhpDocTypesAsCertain: false
