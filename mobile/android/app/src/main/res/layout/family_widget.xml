<?xml version="1.0" encoding="utf-8"?>
<!-- Віджет «Моя сім'я»: рахунок у банку сім'ї, заробіток за тиждень, місце в рейтингу, бізвари, найближча подія. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="GameCon"
            android:textColor="#EEF1FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Оновити"
            android:padding="5dp"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#8B93B3" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_rank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Відкрийте застосунок"
        android:textColor="#8B93B3"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:text="—"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_balance_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ваш рахунок у сім'ї"
        android:textColor="#8B93B3"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/widget_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_week"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:maxLines="2"
            android:padding="6dp"
            android:text="—"
            android:textColor="#34D399"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_place"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:maxLines="2"
            android:padding="6dp"
            android:text="—"
            android:textColor="#F5C451"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_bizwar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:maxLines="2"
            android:padding="6dp"
            android:text="—"
            android:textColor="#A5B4FC"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_event"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#DFE3F7"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:textColor="#5C6385"
        android:textSize="10sp" />
</LinearLayout>
