{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameCon",
  "version": "1.2611.0",
  "identifier": "online.gamecon.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GameCon",
        "url": "https://gamecon.online/feed",
        "width": 1280,
        "height": 860,
        "minWidth": 420,
        "minHeight": 560,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "GameCon — тривога",
        "url": "https://gamecon.online/desktop/overlay",
        "width": 392,
        "height": 140,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Ukrainian", "English"] }
    }
  }
}
