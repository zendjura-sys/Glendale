{
    "name": "gamecon-desktop",
    "productName": "GameCon",
    "version": "1.2611.0",
    "description": "GameCon для Windows: сайт у вікні, значок у треї й оверлей тривог поверх ігор.",
    "main": "src/main.js",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "start": "electron .",
        "check": "node --check src/main.js && node --check src/preload.js && node --check src/overlay.js && node --test test/*.test.js",
        "dist:win": "electron-builder --win nsis --publish never"
    },
    "devDependencies": {
        "electron": "33.2.1",
        "electron-builder": "25.1.8"
    },
    "build": {
        "appId": "online.gamecon.desktop",
        "productName": "GameCon",
        "directories": { "output": "dist", "buildResources": "build" },
        "files": ["src/**/*", "package.json"],
        "win": { "target": ["nsis"], "icon": "build/icon.png" },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "shortcutName": "GameCon",
            "artifactName": "GameCon-Setup-${version}.${ext}"
        }
    }
}
