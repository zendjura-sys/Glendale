<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GameCon" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#05070F</item>
        <item name="android:navigationBarColor">#070A16</item>
        <item name="android:windowBackground">#05070F</item>
    </style>

    <style name="Theme.GameCon.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/gc_void</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.GameCon</item>
    </style>
</resources>
